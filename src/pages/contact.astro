---
/**
 * Contact — Location, directions, map, hours, and business info for Bashful Beauty.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { business } from '../data/business';

/** Full address string */
const fullAddress = `${business.address.street}, ${business.address.city}, ${business.address.state} ${business.address.zip}`;

/** LocalBusiness JSON-LD */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  description: 'Rockwall\'s most trusted beauty studio specializing in waxing, facials, lash lifts, brow shaping, spray tans, and teeth whitening.',
  url: 'https://bashfulbeauty.com/contact',
  telephone: business.phone,
  priceRange: '$$',
  image: '/images/og-default.jpg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 32.9312,
    longitude: -96.4597,
  },
  sameAs: [
    business.social.instagram,
    business.social.facebook,
    business.social.tiktok,
  ],
};
---

<BaseLayout
  title="Contact & Directions | Bashful Beauty Rockwall"
  description="Visit Bashful Beauty Spa at 502 N Goliad St, Rockwall, TX 75087. Located in the cute little cottage behind Bin 303. Call (469) 434-0155."
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ================================================================== -->
  <!-- Hero                                                                -->
  <!-- ================================================================== -->
  <section class="bg-gradient-to-br from-cream via-blush-50 to-linen">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-24 text-center">
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl text-warm-gray-900 leading-tight mb-4">
        Come See Us
      </h1>
      <p class="text-warm-gray-700 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto">
        Downtown Rockwall, TX
      </p>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Contact Info + Map                                                  -->
  <!-- ================================================================== -->
  <section class="py-16 md:py-24 px-6 animate-fade-up">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16">

        <!-- Left Column: Contact details -->
        <div class="space-y-8">
          <!-- Address -->
          <div>
            <h3 class="font-heading text-lg text-warm-gray-900 mb-3">Address</h3>
            <a
              href={business.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-warm-gray-700 hover:text-blush-500 transition leading-relaxed block"
            >
              {business.address.street}<br />
              {business.address.city}, {business.address.state} {business.address.zip}
            </a>
            <p class="mt-2 text-blush-500 italic text-sm font-medium">
              We're in the cute little cottage behind Bin 303
            </p>
          </div>

          <!-- Phone — prominent, click-to-call on mobile -->
          <div>
            <h3 class="font-heading text-lg text-warm-gray-900 mb-3">Call or Text</h3>
            <!-- Mobile: full-width button -->
            <a
              href={business.phoneHref}
              class="flex md:hidden items-center justify-center gap-3 w-full border-2 border-blush-500 text-blush-500 hover:bg-blush-500 hover:text-white px-6 py-4 rounded-full text-xl font-semibold transition"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              {business.phone}
            </a>
            <!-- Desktop: regular prominent link -->
            <a
              href={business.phoneHref}
              class="hidden md:inline-flex items-center gap-2 text-warm-gray-900 hover:text-blush-500 transition text-2xl font-semibold"
            >
              <svg class="w-5 h-5 text-blush-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              {business.phone}
            </a>
          </div>

          <!-- Hours -->
          <div>
            <h3 class="font-heading text-lg text-warm-gray-900 mb-3">Hours</h3>
            {business.hours.length > 0 ? (
              <table class="w-full text-warm-gray-700">
                <tbody>
                  {business.hours.map((h) => (
                    <tr class="border-b border-warm-gray-100 last:border-0">
                      <td class="py-2.5 pr-6 font-medium">{h.day}</td>
                      <td class="py-2.5">{h.open} &ndash; {h.close}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <div class="bg-blush-50 rounded-xl p-4">
                <p class="text-warm-gray-700">
                  Call or text for current hours and availability.
                </p>
                <a
                  href={business.phoneHref}
                  class="text-blush-500 font-semibold text-sm mt-1 inline-block"
                >
                  {business.phone}
                </a>
              </div>
            )}
          </div>

          <!-- Service area -->
          <div>
            <h3 class="font-heading text-lg text-warm-gray-900 mb-3">Serving</h3>
            <p class="text-warm-gray-700 leading-relaxed">
              {business.serviceArea.join(', ')}
            </p>
          </div>
        </div>

        <!-- Right Column: Map + Directions -->
        <div class="flex flex-col items-center gap-4">
          <div class="rounded-2xl overflow-hidden shadow-lg flex-1 min-h-[350px] md:min-h-[400px]">
            <iframe
              src={business.googleMapsEmbed}
              width="100%"
              height="100%"
              style="border:0; min-height:350px;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Bashful Beauty location on Google Maps"
              class="w-full h-full aspect-square md:aspect-auto"
            ></iframe>
          </div>
          <a
            href={business.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-blush-500 text-white px-8 py-3.5 rounded-full text-lg font-semibold hover:bg-blush-600 transition w-full md:w-auto"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
            </svg>
            Get Directions
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Parking / Directions Note                                           -->
  <!-- ================================================================== -->
  <section class="px-6 pb-8 animate-fade-up">
    <div class="max-w-3xl mx-auto">
      <div class="bg-linen rounded-2xl p-6 flex items-start gap-4">
        <!-- Info icon -->
        <div class="shrink-0 text-warm-gray-500 mt-0.5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
          </svg>
        </div>
        <p class="text-warm-gray-700 text-sm leading-relaxed">
          <strong class="text-warm-gray-900">Parking & Directions:</strong> Parking is available behind the building. Look for the cottage behind Bin 303 on N Goliad St in downtown Rockwall.
        </p>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Booking CTA                                                         -->
  <!-- ================================================================== -->
  <BookingCTA />
</BaseLayout>
