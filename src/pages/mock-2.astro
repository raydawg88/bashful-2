---
/**
 * Mock 2 — Editorial Homepage Concept for Bashful Beauty Spa
 * Completely self-contained: own HTML shell, styles, header, footer.
 * Route: /mock-2
 */

import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';

import { business } from '../data/business';
import { serviceCategories, memberships } from '../data/services';
import { testimonials } from '../data/testimonials';

const waxing = serviceCategories.find((c) => c.id === 'waxing')!;
const facials = serviceCategories.find((c) => c.id === 'facials')!;
const lashes = serviceCategories.find((c) => c.id === 'lashes')!;
const brows = serviceCategories.find((c) => c.id === 'brows')!;
const sprayTans = serviceCategories.find((c) => c.id === 'spray-tans')!;
const teethWhitening = serviceCategories.find((c) => c.id === 'teeth-whitening')!;

const google = business.reviews.google;
const mainTestimonial = testimonials.find((t) => t.id === 1)!;
const secondaryTestimonials = testimonials.filter((t) => t.id === 2 || t.id === 3);

const addr = business.address;
const fullAddress = `${addr.street}, ${addr.city}, ${addr.state} ${addr.zip}`;

const secondaryServices = [
  { cat: lashes, image: '/images/services/lashes.jpg', label: 'Lash Lift & Tint' },
  { cat: brows, image: '/images/services/brows.jpg', label: 'Brows' },
  { cat: sprayTans, image: '/images/services/spray-tans.jpg', label: 'Spray Tans' },
  { cat: teethWhitening, image: '/images/services/teeth-whitening.jpg', label: 'Teeth Whitening' },
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{business.name} — {business.tagline}</title>
  <meta name="description" content={`${business.name}: ${business.tagline}. Waxing, facials, lashes & more in ${addr.city}, ${addr.state}.`} />
</head>

<body>

  <!-- ═══════════════════════════════════════════════════════════════════════
       HEADER — Fixed, minimal, elegant
       ═══════════════════════════════════════════════════════════════════════ -->
  <header class="site-header">
    <div class="header-inner">
      <!-- Logo -->
      <a href="/mock-2" class="logo-stack" aria-label="Bashful Beauty home">
        <span class="logo-top">bashful</span>
        <span class="logo-bottom">beauty</span>
      </a>

      <!-- Nav -->
      <nav class="header-nav" aria-label="Main navigation">
        <a href="#services">Waxing</a>
        <a href="#services">Facials</a>
        <a href="#services">Beauty Services</a>
        <a href="#cottage">About</a>
        <a href="#booking-cta">Contact</a>
      </nav>

      <!-- Right side: phone + CTA -->
      <div class="header-right">
        <a href={business.phoneHref} class="header-phone">{business.phone}</a>
        <a href={business.bookingUrl} class="header-cta" target="_blank" rel="noopener">Book Now</a>
      </div>

      <!-- Mobile menu toggle -->
      <button class="mobile-toggle" aria-label="Open menu" id="mobileToggle">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <!-- Mobile nav overlay -->
  <div class="mobile-nav" id="mobileNav">
    <nav>
      <a href="#services">Waxing</a>
      <a href="#services">Facials</a>
      <a href="#services">Beauty Services</a>
      <a href="#cottage">About</a>
      <a href="#booking-cta">Contact</a>
      <a href={business.bookingUrl} class="mobile-book-btn" target="_blank" rel="noopener">Book an Appointment</a>
    </nav>
  </div>


  <!-- ═══════════════════════════════════════════════════════════════════════
       HERO — Typography-first statement
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero-grid">
      <!-- Left: text -->
      <div class="hero-text">
        <h1 class="hero-heading">
          <span class="hero-line">Relax.</span>
          <span class="hero-line">Rejuvenate.</span>
          <span class="hero-glow">Glow.</span>
        </h1>
        <p class="hero-sub">
          {`${20}+`} years of expertise in the heart of {addr.city}, {addr.state}. Where smooth skin and glowing confidence are crafted, not rushed.
        </p>
        <a href={business.bookingUrl} class="btn-outline" target="_blank" rel="noopener">Book an Appointment</a>
        <p class="hero-reviews">
          <span class="review-star">&#9733;</span> {google.rating} · {google.count} Google reviews
        </p>
      </div>

      <!-- Right: photo -->
      <div class="hero-image-wrap">
        <div class="hero-image-bg"></div>
        <img
          src="/images/hero/team-group.jpg"
          alt="The Bashful Beauty team at their cottage studio in Rockwall, TX"
          class="hero-image"
          loading="eager"
          width="720"
          height="900"
        />
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       TRUST STRIP
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="trust-strip">
    <div class="trust-line"></div>
    <p class="trust-text">
      <span class="trust-accent">20</span> years of experience
      &nbsp;·&nbsp;
      <span class="trust-accent">{google.rating}</span> stars from <span class="trust-accent">{google.count}</span> Google reviews
      &nbsp;·&nbsp;
      Downtown {addr.city}, {addr.state}
    </p>
    <div class="trust-line"></div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       SERVICES — Editorial sections
       ═══════════════════════════════════════════════════════════════════════ -->
  <div id="services">

    <!-- Service 01: Waxing -->
    <section class="service-feature service-left">
      <span class="section-number" aria-hidden="true">01</span>
      <div class="service-feature-grid">
        <div class="service-feature-image-wrap service-image-left">
          <img
            src="/images/services/waxing.jpg"
            alt="Professional waxing treatment at Bashful Beauty"
            class="service-feature-img"
            loading="lazy"
            width="800"
            height="1000"
          />
        </div>
        <div class="service-feature-text service-text-right">
          <span class="service-eyebrow">Most Popular</span>
          <h2 class="service-title">{waxing.name}</h2>
          <p class="service-desc">{waxing.description}</p>
          <p class="service-price">
            Brazilian membership from <span class="highlight">{memberships[0].price}/month</span>
          </p>
          <a href="/waxing" class="service-link">Explore Waxing &rarr;</a>
        </div>
      </div>
    </section>

    <!-- Service 02: Facials -->
    <section class="service-feature service-right">
      <span class="section-number section-number-right" aria-hidden="true">02</span>
      <div class="service-feature-grid service-feature-grid-reverse">
        <div class="service-feature-text service-text-left">
          <span class="service-eyebrow">Signature Treatments</span>
          <h2 class="service-title">{facials.name}</h2>
          <p class="service-desc">{facials.description}</p>
          <a href="/facials" class="service-link">Explore Facials &rarr;</a>
        </div>
        <div class="service-feature-image-wrap service-image-right">
          <img
            src="/images/services/facials.jpg"
            alt="Custom facial treatment at Bashful Beauty"
            class="service-feature-img"
            loading="lazy"
            width="800"
            height="1000"
          />
        </div>
      </div>
    </section>

    <!-- Services 03–06: Grid -->
    <section class="services-grid-section">
      <div class="services-grid-container">
        <div class="services-grid">
          {secondaryServices.map((s, i) => (
            <div class="service-card">
              <div class="service-card-img-wrap">
                <img
                  src={s.image}
                  alt={s.label}
                  class="service-card-img"
                  loading="lazy"
                  width="400"
                  height="533"
                />
              </div>
              <h3 class="service-card-name">{s.label}</h3>
              <p class="service-card-sub">{s.cat.subtitle}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>


  <!-- ═══════════════════════════════════════════════════════════════════════
       MEMBERSHIP
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="membership-section">
    <div class="membership-container">
      <div class="membership-header">
        <span class="membership-label">Save with a</span>
        <h2 class="membership-title">membership</h2>
      </div>
      <div class="membership-cards">
        {memberships.map((m) => (
          <div class="membership-card">
            <span class="membership-badge">&#9733; Member</span>
            <h3 class="membership-name">{m.name.replace(' Membership', '')}</h3>
            <div class="membership-price">
              <span class="membership-amount">{m.price}</span>
              <span class="membership-period">/{m.priceNote.replace('per ', '')}</span>
            </div>
            <p class="membership-perk">Unlimited sessions</p>
            <a href={business.bookingUrl} class="membership-link" target="_blank" rel="noopener">Book Now &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       TESTIMONIALS — Pull quote
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="testimonials-section">
    <div class="testimonials-container">
      <span class="testimonial-deco" aria-hidden="true">&ldquo;</span>
      <blockquote class="testimonial-main">
        <p>&ldquo;{mainTestimonial.quote}&rdquo;</p>
      </blockquote>
      <div class="testimonial-author">
        <span class="testimonial-avatar">{mainTestimonial.initials}</span>
        <span class="testimonial-name">&mdash; {mainTestimonial.name} · {mainTestimonial.source}</span>
      </div>

      <div class="testimonials-secondary">
        {secondaryTestimonials.map((t) => (
          <div class="testimonial-small">
            <p class="testimonial-small-quote">&ldquo;{t.quote}&rdquo;</p>
            <div class="testimonial-small-author">
              <span class="testimonial-avatar testimonial-avatar-sm">{t.initials}</span>
              <span class="testimonial-small-name">{t.name} · {t.source}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       THE COTTAGE — Full bleed moment
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="cottage-section" id="cottage">
    <div class="cottage-image-wrap">
      <img
        src="/images/cottage/exterior.jpg"
        alt="Doe's Skincare Cottage — the charming studio behind Bin 303 in Rockwall"
        class="cottage-image"
        loading="lazy"
        width="1600"
        height="900"
      />
      <div class="cottage-overlay"></div>
      <div class="cottage-text">
        <span class="cottage-eyebrow">Our Story</span>
        <h2 class="cottage-heading">
          Doe's Skincare <span class="cottage-script">Cottage</span>
        </h2>
        <p class="cottage-sub">{business.locationNote}</p>
        <a href="/about" class="cottage-link">Meet Doe &amp; the Team &rarr;</a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       YOUR FIRST VISIT — 3 steps
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="first-visit-section">
    <div class="first-visit-container">
      <h2 class="first-visit-heading">Your First <span class="script-accent">Visit</span></h2>
      <div class="first-visit-grid">
        <div class="first-visit-step">
          <span class="step-number">1</span>
          <h3 class="step-title">Book Online</h3>
          <p class="step-desc">Pick your service and a time that works. Same-week openings usually available.</p>
        </div>
        <div class="first-visit-step">
          <span class="step-number">2</span>
          <h3 class="step-title">Arrive &amp; Relax</h3>
          <p class="step-desc">Find the cute cottage behind Bin 303. We'll walk you through everything before we start.</p>
        </div>
        <div class="first-visit-step">
          <span class="step-number">3</span>
          <h3 class="step-title">Leave Glowing</h3>
          <p class="step-desc">Smooth skin, fresh face, and aftercare tips so results last. See you next time.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       BOOKING CTA — Final call
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="booking-cta" id="booking-cta">
    <div class="booking-cta-inner">
      <h2 class="booking-heading">
        Ready to feel <span class="script-accent highlight">amazing</span>?
      </h2>
      <a href={business.bookingUrl} class="btn-outline btn-outline-lg" target="_blank" rel="noopener">Book an Appointment</a>
      <p class="booking-phone">
        Or call us: <a href={business.phoneHref}>{business.phone}</a>
      </p>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       FOOTER — Minimal concept footer
       ═══════════════════════════════════════════════════════════════════════ -->
  <footer class="site-footer">
    <div class="footer-inner">
      <!-- Logo -->
      <div class="footer-logo">
        <span class="logo-top">bashful</span>
        <span class="logo-bottom">beauty</span>
      </div>

      <!-- Nav -->
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/waxing">Waxing</a>
        <a href="/facials">Facials</a>
        <a href="/beauty-services">Beauty Services</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/faq">FAQ</a>
      </nav>

      <!-- Contact -->
      <div class="footer-contact">
        <p>{fullAddress}</p>
        <p><a href={business.phoneHref}>{business.phone}</a></p>
      </div>

      <!-- Social -->
      <div class="footer-social">
        <a href={business.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href={business.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
        </a>
        <a href={business.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      </div>

      <p class="footer-copy">&copy; {new Date().getFullYear()} {business.name}. All rights reserved.</p>
    </div>
  </footer>


  <!-- ═══════════════════════════════════════════════════════════════════════
       AMBIENT ORBS — Decorative background
       ═══════════════════════════════════════════════════════════════════════ -->
  <div class="ambient-orbs" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

</body>
</html>


<style is:global>
/* ═══════════════════════════════════════════════════════════════════════════
   MOCK-2 — Editorial Design System
   ═══════════════════════════════════════════════════════════════════════════ */

:root {
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-script: 'Cormorant Garamond', Georgia, serif;
  --font-body: 'Lato', 'Helvetica Neue', sans-serif;

  --cream: #FFF9F5;
  --blush: #E8607A;
  --blush-light: #FFE4E8;
  --blush-soft: #FFF0F3;
  --rose: #B76E79;
  --gold: #D4AF37;
  --text: #2D2520;
  --text-light: #8A7E74;
  --text-muted: #B8AFA7;
}

/* ── Reset & base ──────────────────────────────────────────────────────── */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  background: var(--cream);
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-body);
  font-weight: 400;
  color: var(--text);
  line-height: 1.7;
  font-size: 17px;
  overflow-x: hidden;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

/* ── Utility classes ───────────────────────────────────────────────────── */

.highlight {
  display: inline;
  background: linear-gradient(to top, var(--blush-light) 35%, transparent 35%);
  padding: 0 0.15em;
}

.script-accent {
  font-family: var(--font-script);
  font-style: italic;
  font-weight: 600;
  font-size: 1.25em;
  color: var(--blush);
}

.section-number {
  position: absolute;
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 10rem;
  line-height: 1;
  color: var(--text);
  opacity: 0.04;
  user-select: none;
  pointer-events: none;
  top: -1rem;
  left: -1rem;
  z-index: 0;
}

.section-number-right {
  left: auto;
  right: -1rem;
}

/* ── Content container ────────────────────────────────────────────────── */
.container {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0 1.5rem;
}


/* ═══════════════════════════════════════════════════════════════════════════
   HEADER
   ═══════════════════════════════════════════════════════════════════════════ */

.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  height: 70px;
  background: rgba(255, 249, 245, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(45, 37, 32, 0.06);
}

.header-inner {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0 1.5rem;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo-stack {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
  flex-shrink: 0;
}

.logo-top {
  font-family: var(--font-serif);
  font-weight: 400;
  font-size: 1.4rem;
  letter-spacing: 0.15em;
  color: var(--text);
  text-transform: lowercase;
}

.logo-bottom {
  font-family: var(--font-script);
  font-style: italic;
  font-weight: 400;
  font-size: 1.1rem;
  letter-spacing: 0.05em;
  color: var(--blush);
  text-transform: lowercase;
}

.header-nav {
  display: none;
  align-items: center;
  gap: 2rem;
}

.header-nav a {
  font-family: var(--font-body);
  font-size: 0.82rem;
  font-weight: 400;
  color: var(--text-light);
  letter-spacing: 0.05em;
  transition: color 0.25s;
}

.header-nav a:hover {
  color: var(--text);
}

.header-right {
  display: none;
  align-items: center;
  gap: 1.25rem;
}

.header-phone {
  font-family: var(--font-body);
  font-size: 0.78rem;
  color: var(--text-light);
  letter-spacing: 0.02em;
}

.header-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--text);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 0.68rem;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  padding: 0.5rem 1.25rem;
  border-radius: 9999px;
  transition: background 0.3s, color 0.3s;
}

.header-cta:hover {
  background: var(--text);
  color: var(--cream);
}

/* Mobile hamburger */
.mobile-toggle {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  z-index: 51;
}

.mobile-toggle span {
  display: block;
  width: 22px;
  height: 1.5px;
  background: var(--text);
  transition: transform 0.3s, opacity 0.3s;
}

/* Mobile nav overlay */
.mobile-nav {
  position: fixed;
  inset: 0;
  z-index: 49;
  background: rgba(255, 249, 245, 0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.mobile-nav.active {
  opacity: 1;
  pointer-events: auto;
}

.mobile-nav nav {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.75rem;
}

.mobile-nav nav a {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 400;
  color: var(--text);
  letter-spacing: 0.05em;
}

.mobile-book-btn {
  margin-top: 1rem;
  border: 1px solid var(--text);
  color: var(--text);
  font-family: var(--font-body) !important;
  font-size: 0.75rem !important;
  font-weight: 400 !important;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  padding: 0.75rem 2rem;
  border-radius: 9999px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   HERO
   ═══════════════════════════════════════════════════════════════════════════ */

.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding-top: 70px; /* header offset */
  position: relative;
  overflow: hidden;
}

.hero-grid {
  max-width: 80rem;
  margin: 0 auto;
  padding: 3rem 1.5rem;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
  align-items: center;
}

.hero-text {
  order: 2;
}

.hero-heading {
  margin-bottom: 1.5rem;
}

.hero-line {
  display: block;
  font-family: var(--font-serif);
