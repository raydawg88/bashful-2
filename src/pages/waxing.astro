---
/**
 * Waxing — Full waxing services page for Bashful Beauty.
 * Elegant menu-style layout grouped by body area for female, male, and junior.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { memberships } from '../data/services';
import { business } from '../data/business';

const title = 'Waxing Services in Rockwall, TX';
const description =
  'Expert waxing for every body at Bashful Beauty Spa. Brazilian, bikini, full body waxing in Rockwall, TX. Membership plans available from $55/month.';

/* ------------------------------------------------------------------ */
/* Manually grouped service names by body area                        */
/* ------------------------------------------------------------------ */
const femaleGroups = [
  {
    heading: 'Face',
    services: [
      'Brow Shaping',
      'Chin',
      'Lip',
      'Ears',
      'Nose (Inside)',
      'Nose (top)',
      'Facial Cheek Wax',
      'Forehead',
      'Sideburns',
      'Unibrow',
    ],
  },
  {
    heading: 'Body',
    services: [
      'Underarm',
      'Chest',
      'Abdomen',
      'Full Back',
      'Half Back',
      'Neck',
      'Full Arms',
      'Half Arms',
      'Hands & Fingers',
      'Feet & Toes',
    ],
  },
  {
    heading: 'Legs',
    services: ['Full Legs', 'Upper Half Legs', 'Lower Half Legs', 'Inner Thigh'],
  },
  {
    heading: 'Bikini & Brazilian',
    services: [
      'Basic Bikini',
      'Extended Bikini',
      'Brazilian',
      'Brazilian/Buttocks',
      'Extended Bikini/Inner Backside Combo',
      'Buttocks (includes inner backside)',
      'Buttocks add on to Membership',
      'Inner Backside',
    ],
  },
  {
    heading: 'Full Body',
    services: ['Full Body Wax', 'Full Face (brows not included)'],
  },
];

const maleGroups = [
  {
    heading: 'Face & Head',
    services: ['Brow', 'Cheek', 'Ears', 'Nose (Inside)', 'Unibrow', 'Head Wax'],
  },
  {
    heading: 'Upper Body',
    services: [
      'Chest',
      'Abs',
      'Chest/Ab Combo',
      'Full Back',
      'Half Back',
      'Full Arms',
      'Half Arms',
      'Fingers',
      'Underarms',
    ],
  },
  {
    heading: 'Lower Body',
    services: ['Full Legs', 'Upper Half Legs', 'Lower Half Legs'],
  },
  {
    heading: 'Brazilian & Grooming',
    services: [
      'Man-Zilian (Brazilian for Males)',
      'Man-Zilian/Buttocks',
      'Buttocks (includes inner backside)',
      'Inner Backside',
      'Grooming Package',
      'Grooming Package Deluxe',
    ],
  },
  {
    heading: 'Full Body',
    services: ['Full Body Wax'],
  },
];

const juniorServices = [
  'Brow Shaping (13 yrs and under)',
  'Lip (13 yrs and under)',
  '1/2 Leg (13 yrs and under)',
  'Full Leg (13 yrs and under)',
  'Underarm',
  'Unibrow',
];

/** Services that get a "Popular" badge */
const popularFemale = new Set(['Brazilian', 'Full Body Wax']);
const popularMale = new Set(['Man-Zilian (Brazilian for Males)', 'Grooming Package']);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Waxing Services',
  description,
  provider: {
    '@type': 'BeautySalon',
    name: business.name,
    telephone: business.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: business.address.street,
      addressLocality: business.address.city,
      addressRegion: business.address.state,
      postalCode: business.address.zip,
    },
  },
  areaServed: business.serviceArea.map((city) => ({
    '@type': 'City',
    name: city,
  })),
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ============================================================= -->
  <!-- Hero                                                           -->
  <!-- ============================================================= -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/services/waxing.jpg"
        alt="Waxing treatment at Bashful Beauty Spa in Rockwall, TX"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-cream via-cream/70 to-blush-500/10"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-6 py-12 md:py-16">
      <div class="max-w-xl animate-fade-up">
        <p class="font-body text-xs font-bold uppercase tracking-widest text-blush-500 mb-3">
          Hair Removal
        </p>
        <h1 class="font-heading text-5xl md:text-6xl text-warm-gray-900 mb-6">
          Waxing
        </h1>
        <p class="font-body text-base md:text-lg text-warm-gray-600 leading-relaxed max-w-2xl mb-8">
          Nobody looks forward to a wax. We get it. That's why every wax at Bashful Beauty is
          designed to be as quick and comfortable as possible — premium hard wax that's gentler
          on sensitive skin, private treatment rooms in our Rockwall cottage, and estheticians
          who've done thousands of these. Most clients are in and out wondering why they waited
          so long to switch from shaving.
        </p>
        <a
          href={business.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center bg-blush-500 text-white px-8 py-3.5 rounded-full font-semibold text-base hover:bg-blush-600 transition min-h-[48px]"
        >
          Book a Waxing Appointment
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- Membership Spotlight                                           -->
  <!-- ============================================================= -->
  <section class="pt-8 md:pt-12 pb-12 md:pb-16 px-6">
    <div class="max-w-3xl mx-auto animate-fade-up">
      <div class="text-center mb-6">
        <h2 class="font-heading text-3xl md:text-4xl text-warm-gray-900 mb-3">
          Wax Memberships
        </h2>
        <div class="mx-auto mt-3 mb-6 h-[2px] w-[60px] bg-blush-300"></div>
        <p class="font-body text-base md:text-lg text-warm-gray-600 leading-relaxed max-w-xl mx-auto">
          Consistent results at a price that makes sense. Lock in your monthly rate and never
          think about it again.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {memberships.map((m) => (
          <div class="relative bg-white rounded-2xl overflow-hidden shadow-sm border border-warm-gray-100">
            <!-- Gold gradient top border -->
            <div class="h-1.5 bg-gradient-to-r from-gold-light via-gold-soft to-gold-light"></div>
            <div class="p-8 text-center">
              <span class="inline-block bg-gold-soft/30 text-gold-light rounded-full px-4 py-1 text-xs font-bold tracking-widest uppercase mb-5">
                Member Exclusive
              </span>
              <h3 class="font-heading text-2xl text-warm-gray-900 mb-3">{m.name}</h3>
              <p class="text-4xl font-bold text-warm-gray-900 mb-1">
                {m.price}<span class="text-base font-normal text-warm-gray-500">/{m.priceNote.replace('per ', '')}</span>
              </p>
              <p class="font-body text-warm-gray-600 text-sm mb-8">
                Unlimited sessions every month
              </p>
              <a
                href={business.bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center bg-blush-500 text-white px-8 py-3.5 rounded-full font-semibold text-base hover:bg-blush-600 transition min-h-[48px]"
              >
                Book Now
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-[80px] h-[2px] bg-blush-300/50 mx-auto my-8"></div>

  <!-- ============================================================= -->
  <!-- Female Waxing Menu                                             -->
  <!-- ============================================================= -->
  <section class="py-12 md:py-16 px-6">
    <div class="max-w-4xl mx-auto animate-fade-up">
      <div class="text-center mb-8">
        <p class="font-body text-xs font-bold uppercase tracking-widest text-blush-500 mb-2">For Her</p>
        <h2 class="font-heading text-3xl md:text-4xl text-warm-gray-900">
          Female Waxing
        </h2>
        <div class="mx-auto mt-3 h-[2px] w-[60px] bg-blush-300"></div>
      </div>

      <!-- Lifestyle image to break up text -->
      <img
        src="/images/services/waxing.jpg"
        alt="Waxing services at Bashful Beauty Spa"
        class="w-full max-h-[300px] object-cover rounded-2xl mb-10"
        loading="lazy"
      />

      <div class="space-y-10">
        {femaleGroups.map((group) => (
          <div>
            <!-- Level 3 — Category Subheader -->
            <div class="flex items-center gap-3 mt-10 mb-4">
              <span class="w-[20px] h-[3px] bg-blush-300 shrink-0"></span>
              <h3 class="font-body text-sm font-bold uppercase tracking-widest text-blush-500">
                {group.heading}
              </h3>
            </div>

            <!-- Level 4 — Service names, 2-col desktop -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8">
              {group.services.map((service) => (
                <div class="py-3 border-b border-warm-gray-200/40">
                  <span class="font-body text-base md:text-lg font-medium text-warm-gray-800">
                    {service}
                  </span>
                  {popularFemale.has(service) && (
                    <span class="bg-blush-500 text-white text-xs px-3 py-1 rounded-full inline-block ml-2">
                      Popular
                    </span>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-[80px] h-[2px] bg-blush-300/50 mx-auto my-8"></div>

  <!-- ============================================================= -->
  <!-- Male Waxing Menu                                               -->
  <!-- ============================================================= -->
  <section class="py-12 md:py-16 px-6">
    <div class="max-w-4xl mx-auto animate-fade-up">
      <div class="text-center mb-8">
        <p class="font-body text-xs font-bold uppercase tracking-widest text-blush-500 mb-2">For Him</p>
        <h2 class="font-heading text-3xl md:text-4xl text-warm-gray-900">
          Male Waxing
        </h2>
        <div class="mx-auto mt-3 h-[2px] w-[60px] bg-blush-300"></div>
      </div>

      <!-- Placeholder image between female and male sections -->
      <img
        src="/images/services/waxing.jpg"
        alt="Male waxing services at Bashful Beauty Spa"
        class="w-full max-h-[240px] object-cover rounded-2xl mb-10"
        loading="lazy"
      />

      <div class="space-y-10">
        {maleGroups.map((group) => (
          <div>
            <!-- Level 3 — Category Subheader -->
            <div class="flex items-center gap-3 mt-10 mb-4">
              <span class="w-[20px] h-[3px] bg-blush-300 shrink-0"></span>
              <h3 class="font-body text-sm font-bold uppercase tracking-widest text-blush-500">
                {group.heading}
              </h3>
            </div>

            <!-- Level 4 — Service names, 2-col desktop -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8">
              {group.services.map((service) => (
                <div class="py-3 border-b border-warm-gray-200/40">
                  <span class="font-body text-base md:text-lg font-medium text-warm-gray-800">
                    {service}
                  </span>
                  {popularMale.has(service) && (
                    <span class="bg-blush-500 text-white text-xs px-3 py-1 rounded-full inline-block ml-2">
                      Popular
                    </span>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-[80px] h-[2px] bg-blush-300/50 mx-auto my-8"></div>

  <!-- ============================================================= -->
  <!-- Junior Waxing                                                  -->
  <!-- ============================================================= -->
  <section class="py-12 md:py-16 px-6">
    <div class="max-w-2xl mx-auto animate-fade-up">
      <div class="text-center mb-8">
        <p class="font-body text-xs font-bold uppercase tracking-widest text-blush-500 mb-2">Ages 13 &amp; Under</p>
        <h2 class="font-heading text-3xl md:text-4xl text-warm-gray-900">
          Junior Waxing
        </h2>
        <div class="mx-auto mt-3 h-[2px] w-[60px] bg-blush-300"></div>
      </div>

      <!-- Single column for junior services -->
      <div>
        {juniorServices.map((service) => (
          <div class="py-3 border-b border-warm-gray-200/40">
            <span class="font-body text-base md:text-lg font-medium text-warm-gray-800">
              {service}
            </span>
          </div>
        ))}
      </div>

      <!-- Guardian note card -->
      <div class="mt-8 bg-blush-50 border border-blush-200 rounded-2xl p-6">
        <p class="font-body text-base text-warm-gray-700 leading-relaxed">
          All junior services require a parent or guardian present for clients 13 and under.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- What to Expect                                                 -->
  <!-- ============================================================= -->
  <section class="py-12 md:py-16 px-6">
    <div class="max-w-3xl mx-auto animate-fade-up">
      <h2 class="font-heading text-3xl md:text-4xl text-warm-gray-900 mb-6 text-center">
        What to Expect at Your First Wax
      </h2>
      <div class="mx-auto mb-8 h-[2px] w-[60px] bg-blush-300"></div>
      <div class="border-l-[3px] border-blush-300 bg-linen rounded-r-2xl p-8 sm:p-10 text-warm-gray-700 text-base md:text-lg leading-relaxed space-y-4">
        <p>
          A waxing appointment at Bashful Beauty typically takes 15-60 minutes depending on
          the service. We use premium hard wax that adheres to hair, not skin — making the
          process much more comfortable than strip wax. Your esthetician will walk you through
          every step.
        </p>
        <p>
          First-timers: we recommend letting hair grow at least 2-3 weeks from your last
          shave. This gives the wax enough length to grip for the cleanest, longest-lasting
          results.
        </p>
        <p>
          Have more questions? Check out our
          <a href="/faq" class="text-blush-500 underline hover:text-blush-600 transition">
            FAQ page
          </a>
          for full pre- and post-wax care tips.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- Booking CTA                                                    -->
  <!-- ============================================================= -->
  <BookingCTA
    heading="Ready for Smooth Skin?"
    subtext="Book your waxing appointment today — first-timers and regulars welcome."
  />
</BaseLayout>
