---
/**
 * Facials — Full facials and skincare services page for Bashful Beauty.
 * Elegant menu layout with skin concern guide and grouped treatment categories.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCTA from '../components/BookingCTA.astro';
import WatercolorDivider from '../components/WatercolorDivider.astro';
import { serviceCategories } from '../data/services';
import { business } from '../data/business';

const title = 'Custom Facials in Rockwall, TX';
const description =
  'Personalized facial treatments at Bashful Beauty Spa. Anti-aging, acne, hydration — every facial is customized to your skin goals. Book your appointment in Rockwall, TX.';

const facials = serviceCategories.find((c) => c.id === 'facials')!;
const upgrades = facials.subGroups?.find((g) => g.label === 'Upgrades');

/* ------------------------------------------------------------------ */
/* Skin concern guide                                                 */
/* ------------------------------------------------------------------ */
const skinConcerns = [
  {
    concern: 'Aging & Fine Lines',
    recommendations: ['Anti Aging Peptide Facial', 'SWiCH Treatment'],
  },
  {
    concern: 'Acne & Breakouts',
    recommendations: ['Custom Facial', 'Custom Chemical Peel', 'Teen Facial'],
  },
  {
    concern: 'Dull or Dry Skin',
    recommendations: ['Super Berry Brightening Facial', 'Custom Hydra-facial'],
  },
  {
    concern: 'First Time?',
    recommendations: ['Custom Express Facial', 'Custom Facial'],
  },
];

/* ------------------------------------------------------------------ */
/* Grouped treatment categories                                       */
/* ------------------------------------------------------------------ */
const treatmentGroups = [
  {
    heading: 'Signature Facials',
    services: ['Custom Facial', 'Custom Express Facial', "Custom Couple's Facial"],
  },
  {
    heading: 'Specialty Treatments',
    services: [
      'Anti Aging Peptide Facial',
      'Super Berry Brightening Facial',
      'Custom CBD Facial',
      'Custom Oxygen RX Facial',
      'Pregnancy Facial',
      'Teen Facial (19 and under ONLY)',
    ],
  },
  {
    heading: 'Peels & Resurfacing',
    services: [
      'Custom Chemical Peel',
      'Custom Enzyme Peel Facial',
      'Custom Microdermabrasion Facial',
      'Custom Hydra-facial',
      'SWiCH Treatment',
      'Dermablading Enzyme Peel & Hydrating Mask Treatment',
    ],
  },
  {
    heading: 'Advanced',
    services: [
      'Micro Needling',
      'Custom Back Facial',
      'Custom Chest/Ab Facial',
      'Series Follow Up Facial',
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Facial Treatments',
  description,
  provider: {
    '@type': 'BeautySalon',
    name: business.name,
    telephone: business.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: business.address.street,
      addressLocality: business.address.city,
      addressRegion: business.address.state,
      postalCode: business.address.zip,
    },
  },
  areaServed: business.serviceArea.map((city) => ({
    '@type': 'City',
    name: city,
  })),
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ============================================================= -->
  <!-- Hero                                                           -->
  <!-- ============================================================= -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/services/facials.jpg"
        alt="Custom facial treatment at Bashful Beauty Spa in Rockwall, TX"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-cream via-cream/70 to-blush-500/10"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-6 py-24 sm:py-32 lg:py-40">
      <div class="max-w-xl animate-fade-up">
        <p class="text-blush-500 font-semibold tracking-widest uppercase text-xs mb-3">
          Customized Skincare
        </p>
        <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl text-warm-gray-900 mb-6">
          Facials
        </h1>
        <p class="text-warm-gray-700 text-lg leading-relaxed mb-8">
          Every face is different — that's why every facial at Bashful Beauty is fully
          customized. Your esthetician analyzes your skin, selects the right products, and
          builds a treatment plan around your specific goals. Whether you're fighting
          breakouts, chasing that glow, or staying ahead of fine lines, we'll get you there.
        </p>
        <a
          href={business.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-blush-500 text-white px-8 py-3.5 rounded-full text-lg font-semibold hover:bg-blush-600 transition min-h-[44px]"
        >
          Book a Facial
        </a>
      </div>
    </div>
  </section>

  <WatercolorDivider />

  <!-- ============================================================= -->
  <!-- Skin Concern Guide                                             -->
  <!-- ============================================================= -->
  <section class="py-16 sm:py-20 px-6">
    <div class="max-w-4xl mx-auto animate-fade-up">
      <div class="text-center mb-10">
        <h2 class="font-heading text-3xl sm:text-4xl text-warm-gray-900 mb-3">
          Not Sure Which Facial? Start Here.
        </h2>
        <p class="text-warm-gray-600 text-lg max-w-2xl mx-auto">
          Tell us your skin concern and we'll point you in the right direction.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        {skinConcerns.map((sc) => (
          <div class="bg-blush-50 rounded-2xl p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-2 h-2 rounded-full bg-blush-400 shrink-0"></span>
              <h3 class="font-heading text-xl text-warm-gray-900">{sc.concern}</h3>
            </div>
            <p class="text-warm-gray-500 text-xs uppercase tracking-widest font-semibold mb-2">
              We recommend
            </p>
            <ul class="space-y-1.5">
              {sc.recommendations.map((rec) => (
                <li class="text-warm-gray-700 text-[15px] leading-snug">{rec}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <WatercolorDivider />

  <!-- ============================================================= -->
  <!-- Facial Treatments Menu                                         -->
  <!-- ============================================================= -->
  <section class="py-16 sm:py-20 px-6">
    <div class="max-w-4xl mx-auto animate-fade-up">
      <div class="text-center mb-12">
        <p class="text-blush-500 font-semibold tracking-widest uppercase text-xs mb-2">
          The Menu
        </p>
        <h2 class="font-heading text-3xl sm:text-4xl text-warm-gray-900">
          Facial Treatments
        </h2>
      </div>

      <div class="space-y-10">
        {treatmentGroups.map((group) => (
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="w-6 h-px bg-blush-300"></span>
              <h3 class="font-heading text-lg text-blush-500">{group.heading}</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2">
              {group.services.map((service) => (
                <div class="py-3 px-1 border-b border-warm-gray-200/50">
                  <span class="font-body text-base font-medium text-warm-gray-900">
                    {service}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <WatercolorDivider />

  <!-- ============================================================= -->
  <!-- Upgrades                                                       -->
  <!-- ============================================================= -->
  {upgrades && (
    <section class="py-16 sm:py-20 px-6">
      <div class="max-w-3xl mx-auto animate-fade-up">
        <div class="text-center mb-8">
          <h2 class="font-heading text-3xl sm:text-4xl text-warm-gray-900 mb-3">
            Facial Upgrades
          </h2>
          <p class="text-warm-gray-600 text-lg">
            Enhance any facial with these add-ons.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8">
          {upgrades.items.map((item) => (
            <div class="flex items-center gap-3 py-2.5 border-b border-warm-gray-200/30">
              <svg class="w-4 h-4 text-blush-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span class="text-warm-gray-700 text-[15px]">{item.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <WatercolorDivider />

  <!-- ============================================================= -->
  <!-- What to Expect                                                 -->
  <!-- ============================================================= -->
  <section class="py-16 sm:py-20 px-6">
    <div class="max-w-3xl mx-auto animate-fade-up">
      <h2 class="font-heading text-3xl sm:text-4xl text-warm-gray-900 mb-8 text-center">
        What to Expect at Your Facial
      </h2>
      <div class="border-l-[3px] border-blush-300 bg-linen rounded-r-2xl p-8 sm:p-10 text-warm-gray-700 text-lg leading-relaxed space-y-4">
        <p>
          Every facial at Bashful Beauty begins with a one-on-one skin analysis. Your
          esthetician will examine your skin under proper lighting, ask about your goals and
          any sensitivities, then build a treatment plan on the spot — no cookie-cutter facials
          here.
        </p>
        <p>
          Most facial appointments run 45-75 minutes depending on the treatment. Plan to
          arrive with a clean face (no makeup if possible) and avoid heavy exfoliation or
          retinol products for 48 hours before your visit.
        </p>
        <p>
          After your treatment, your esthetician will walk you through a simple at-home routine
          to keep results going between visits. Have questions beforehand? Check out our
          <a href="/faq" class="text-blush-500 underline hover:text-blush-600 transition">
            FAQ page
          </a>
          for everything you need to know.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- Booking CTA                                                    -->
  <!-- ============================================================= -->
  <BookingCTA
    heading="Your Skin Deserves This"
    subtext="Book a custom facial today and let your esthetician build the perfect treatment for you."
  />
</BaseLayout>
