---
/**
 * [slug] — Dynamic blog post page for Skincare Stories.
 * Renders a single blog post from the blog-posts data file.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import { blogPosts } from '../../data/blog-posts';
import type { BlogPost } from '../../data/blog-posts';
import { business } from '../../data/business';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

/**
 * Format an ISO date string to a human-readable format.
 * @param dateStr - ISO date string (e.g. "2026-03-10")
 * @returns Formatted date string (e.g. "March 10, 2026")
 */
function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

/** Article JSON-LD structured data */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  image: post.heroImage,
  datePublished: post.publishDate,
  author: {
    '@type': 'Organization',
    name: business.name,
    url: 'https://bashfulbeauty.com',
  },
  publisher: {
    '@type': 'Organization',
    name: business.name,
    url: 'https://bashfulbeauty.com',
  },
};
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  ogImage={post.heroImage}
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero Image -->
  <div class="relative w-full max-h-[50vh] overflow-hidden">
    <img
      src={post.heroImage}
      alt={post.title}
      class="w-full h-full object-cover max-h-[50vh]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-cream/80 via-cream/20 to-transparent"></div>
  </div>

  <!-- Article Header -->
  <article class="px-6">
    <div class="max-w-3xl mx-auto -mt-16 relative z-10">
      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-3 mb-4 animate-fade-up">
        <span class="inline-block bg-blush-50 text-blush-500 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full">
          {post.category}
        </span>
        <span class="text-sm text-warm-gray-500">
          {post.readTime}
        </span>
        <span class="text-sm text-warm-gray-400">&middot;</span>
        <span class="text-sm text-warm-gray-500">
          {formatDate(post.publishDate)}
        </span>
      </div>

      <!-- Title -->
      <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl text-warm-gray-900 leading-tight mb-10 animate-fade-up">
        {post.title}
      </h1>

      <!-- Content -->
      <div class="blog-content animate-fade-up" set:html={post.content} />

      <!-- Back link -->
      <div class="mt-12 mb-4">
        <a
          href="/skincare-stories"
          class="text-blush-500 font-semibold hover:text-blush-600 transition"
        >
          &larr; Back to Skincare Stories
        </a>
      </div>
    </div>
  </article>

  <!-- Contextual Booking CTA -->
  <BookingCTA
    heading="Book Your Appointment"
    subtext={post.ctaText}
  />
</BaseLayout>

<style>
  /* Blog post content typography */
  .blog-content :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--color-warm-gray-900);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .blog-content :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-warm-gray-900);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .blog-content :global(p) {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-warm-gray-700);
    margin-bottom: 1rem;
  }

  .blog-content :global(ul) {
    list-style: none;
    padding-left: 0;
    margin-bottom: 1rem;
  }

  .blog-content :global(li) {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-warm-gray-700);
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.5rem;
  }

  .blog-content :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-blush-300);
  }

  .blog-content :global(strong) {
    color: var(--color-warm-gray-900);
    font-weight: 600;
  }

  .blog-content :global(em) {
    font-style: italic;
  }
</style>
