---
/**
 * Homepage — Bashful Beauty Spa
 * Pass 2: Warm, editorial, organic layout with broken grids and texture.
 * Korean beauty brand meets Texas cottage charm.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FloralAccent from '../components/FloralAccent.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { business } from '../data/business';
import { memberships } from '../data/services';
import { testimonials } from '../data/testimonials';

/** Featured testimonial — the "attention to detail" review */
const featuredTestimonial = testimonials[0];
/** Two supporting testimonials */
const supportingTestimonials = [testimonials[1], testimonials[2]];

/** Smaller service cards (non-editorial) */
const smallServiceCards = [
  {
    title: 'Lash Lift & Tint',
    href: '/beauty-services#lashes',
    imageSrc: '/images/services/lashes.jpg',
    description: 'Dramatic, eye-catching results using your natural lashes.',
  },
  {
    title: 'Brows',
    href: '/beauty-services#brows',
    imageSrc: '/images/services/brows.jpg',
    description: 'Shaping, tinting, and lamination for your perfect arch.',
  },
  {
    title: 'Spray Tans',
    href: '/beauty-services#spray-tans',
    imageSrc: '/images/services/spray-tans.jpg',
    description: 'Natural-looking golden glow. Perfect for any occasion.',
  },
  {
    title: 'Teeth Whitening',
    href: '/beauty-services#teeth-whitening',
    imageSrc: '/images/services/teeth-whitening.jpg',
    description: 'Dramatic results in as little as one hour.',
  },
];

/** Membership value prop descriptions */
const membershipDescriptions: Record<string, string> = {
  'Brazilian Membership': 'Unlimited Brazilians. Come as often as you want.',
  'Manzilian Membership': 'Unlimited Manzilians. No limits, no hassle.',
};

/** LocalBusiness JSON-LD structured data */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  description: 'Rockwall\'s most trusted beauty studio specializing in waxing, facials, lash lifts, brow shaping, spray tans, and teeth whitening.',
  url: 'https://bashfulbeauty.com',
  telephone: business.phone,
  priceRange: '$$',
  image: '/images/og-default.jpg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 32.9312,
    longitude: -96.4597,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: business.reviews.google.rating,
    reviewCount: business.reviews.google.count,
    bestRating: 5,
  },
  sameAs: [
    business.social.instagram,
    business.social.facebook,
    business.social.tiktok,
  ],
};
---

<BaseLayout
  title="Rockwall's Most Trusted Beauty Studio"
  description="Bashful Beauty is Rockwall's most trusted beauty studio — waxing, facials, lash lifts, brow shaping, spray tans, and teeth whitening. 4.9 stars from 181 Google reviews. Book your appointment today."
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ================================================================== -->
  <!-- 1. Hero — Dramatic, immersive, asymmetric                          -->
  <!-- ================================================================== -->
  <section class="relative overflow-hidden">
    <!-- MOBILE: Full-width image with gradient overlay -->
    <div class="md:hidden relative">
      <div class="relative aspect-[4/3] w-full max-h-[65vh]">
        <img
          src="/images/hero/team-group.jpg"
          alt="The Bashful Beauty team at their downtown Rockwall cottage studio"
          class="w-full h-full object-cover object-top"
        />
        <!-- Gradient overlay from bottom -->
        <div class="absolute inset-0 bg-gradient-to-t from-cream via-cream/60 to-transparent"></div>
      </div>
      <!-- Text overlaid at the bottom -->
      <div class="absolute bottom-0 inset-x-0 px-6 pb-10 animate-fade-up">
        <h1 class="font-heading text-4xl text-warm-gray-900 leading-tight mb-3">
          Relax. Rejuvenate. <span class="text-blush-500">Glow.</span>
        </h1>
        <p class="text-warm-gray-700 text-base leading-relaxed mb-6">
          20 years of expertise. One appointment at a time.
        </p>
        <a
          href={business.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-blush-500 text-white px-8 py-3.5 rounded-full text-base font-semibold hover:bg-blush-600 transition shadow-sm min-h-[44px]"
        >
          Book an Appointment
        </a>
        <p class="mt-4 text-warm-gray-500 text-sm">
          <span class="text-gold-light">&#9733;</span>
          {business.reviews.google.rating} stars &middot; {business.reviews.google.count} Google reviews
        </p>
      </div>
    </div>

    <!-- DESKTOP: Asymmetric split layout -->
    <div class="hidden md:block relative bg-cream">
      <FloralAccent position="top-right" size="lg" opacity={0.12} />
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-12 min-h-[70vh] items-center">
          <!-- Text: left 5 columns with breathing room -->
          <div class="col-span-5 px-10 lg:px-16 py-20 animate-fade-up">
            <h1 class="font-heading text-5xl lg:text-6xl xl:text-7xl text-warm-gray-900 leading-[1.1] mb-6">
              Relax.<br /> Rejuvenate.<br /> <span class="text-blush-500">Glow.</span>
            </h1>
            <p class="text-warm-gray-700 text-lg lg:text-xl leading-relaxed mb-8 max-w-md">
              20 years of expertise. One appointment at a time.
            </p>
            <a
              href={business.bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-blush-500 text-white px-10 py-4 rounded-full text-lg font-semibold hover:bg-blush-600 transition shadow-sm hover:shadow-md"
            >
              Book an Appointment
            </a>
            <p class="mt-6 text-warm-gray-500 text-sm">
              <span class="text-gold-light">&#9733;</span>
              {business.reviews.google.rating} stars &middot; {business.reviews.google.count} Google reviews
            </p>
          </div>

          <!-- Image: right 7 columns, bleeds to right edge -->
          <div class="col-span-7 relative h-full max-h-[70vh]">
            <img
              src="/images/hero/team-group.jpg"
              alt="The Bashful Beauty team at their downtown Rockwall cottage studio"
              class="w-full h-full object-cover object-top rounded-l-[3rem]"
              style="max-height: 70vh;"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- 2. Why Bashful — Trust signals                                     -->
  <!-- ================================================================== -->
  <section class="pt-8 pb-12 md:pt-12 md:pb-16 px-6 bg-blush-50">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-8 text-center">
        <!-- Prop 1: Experience -->
        <div class="animate-fade-up stagger-1">
          <p class="font-heading text-4xl md:text-5xl text-blush-500 mb-2">20+</p>
          <p class="text-warm-gray-900 font-semibold text-lg mb-1">Years</p>
          <p class="text-warm-gray-600 text-sm">Experience you can trust</p>
        </div>
        <!-- Prop 2: Rating -->
        <div class="animate-fade-up stagger-2">
          <p class="font-heading text-4xl md:text-5xl text-blush-500 mb-2">4.9 <span class="text-gold-light">&#9733;</span></p>
          <p class="text-warm-gray-900 font-semibold text-lg mb-1">Rating</p>
          <p class="text-warm-gray-600 text-sm">{business.reviews.google.count} Google reviews</p>
        </div>
        <!-- Prop 3: The Cottage -->
        <div class="animate-fade-up stagger-3">
          <p class="font-heading text-4xl md:text-5xl text-blush-500 mb-2">Est. 2004</p>
          <p class="text-warm-gray-900 font-semibold text-lg mb-1">Downtown</p>
          <p class="text-warm-gray-600 text-sm">Rockwall, TX</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- 3. Services — Editorial layout                                     -->
  <!-- ================================================================== -->
  <section id="services" class="py-12 md:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <!-- Section heading -->
      <div class="text-center mb-14 md:mb-20 animate-fade-up">
        <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl text-warm-gray-900 mb-4">
          What We Do
        </h2>
        <p class="text-warm-gray-700 text-lg max-w-xl mx-auto leading-relaxed">
          From head-to-toe waxing to rejuvenating facials, every service is designed to make you glow.
        </p>
      </div>

      <!-- Editorial Block 1: Waxing — image left, text right -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center mb-16 md:mb-24">
        <div class="md:col-span-7 animate-fade-up">
          <a href="/waxing" class="block overflow-hidden group">
            <img
              src="/images/services/waxing.jpg"
              alt="Professional waxing services at Bashful Beauty"
              class="w-full aspect-[4/3] object-cover image-frame-organic group-hover:scale-[1.02] transition-transform duration-500"
              loading="lazy"
            />
          </a>
        </div>
        <div class="md:col-span-5 animate-fade-up stagger-1">
          <p class="text-blush-500 font-semibold text-sm uppercase tracking-widest mb-3">Most Popular</p>
          <h3 class="font-heading text-2xl md:text-3xl text-warm-gray-900 mb-4">Waxing</h3>
          <p class="text-warm-gray-700 text-base md:text-lg leading-relaxed mb-6">
            Expert waxing for every body. Brazilian, bikini, full body — our signature hard-wax technique is gentle on even the most sensitive skin. You'll leave silky-smooth and bump-free every time.
          </p>
          <a
            href="/waxing"
            class="inline-block text-blush-500 font-semibold text-base hover:text-blush-600 transition"
          >
            Explore Waxing &rarr;
          </a>
        </div>
      </div>

      <!-- Editorial Block 2: Facials — text left, image right -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center mb-16 md:mb-24">
        <div class="md:col-span-5 order-2 md:order-1 animate-fade-up stagger-1">
          <p class="text-blush-500 font-semibold text-sm uppercase tracking-widest mb-3">Signature Treatment</p>
          <h3 class="font-heading text-2xl md:text-3xl text-warm-gray-900 mb-4">Facials</h3>
          <p class="text-warm-gray-700 text-base md:text-lg leading-relaxed mb-6">
            Custom facials tailored to your skin goals. Every session starts with a thorough skin analysis so we can give you exactly what your skin needs — from deep-cleansing peels to hydrating oxygen infusions.
          </p>
          <a
            href="/facials"
            class="inline-block text-blush-500 font-semibold text-base hover:text-blush-600 transition"
          >
            Explore Facials &rarr;
          </a>
        </div>
        <div class="md:col-span-7 order-1 md:order-2 animate-fade-up">
          <a href="/facials" class="block overflow-hidden group">
            <img
              src="/images/services/facials.jpg"
              alt="Custom facial treatments at Bashful Beauty"
              class="w-full aspect-[4/3] object-cover image-frame-organic group-hover:scale-[1.02] transition-transform duration-500"
              loading="lazy"
            />
          </a>
        </div>
      </div>

      <!-- Smaller services grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {smallServiceCards.map((card, i) => (
          <div class:list={["animate-fade-up", `stagger-${i + 1}`]}>
            <ServiceCard
              title={card.title}
              description={card.description}
              href={card.href}
              imageSrc={card.imageSrc}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-20 h-0.5 bg-blush-300/40 mx-auto my-8" aria-hidden="true"></div>

  <!-- ================================================================== -->
  <!-- 4. Membership Spotlight — Textured, warm                           -->
  <!-- ================================================================== -->
  <section class="relative py-12 md:py-16 px-6 overflow-hidden">
    <!-- Watercolor wash background texture -->
    <div
      class="absolute inset-0 bg-cover bg-center opacity-20 pointer-events-none"
      style="background-image: url('/textures/watercolor-wash-blush.svg');"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-blush-50/80 pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-4xl mx-auto">
      <!-- Section header -->
      <div class="text-center mb-12 animate-fade-up">
        <h2 class="font-heading text-3xl sm:text-4xl text-warm-gray-900 mb-3">
          Save With a Membership
        </h2>
        <p class="text-warm-gray-700 text-lg">
          Unlimited Brazilians — <span class="font-semibold text-warm-gray-900">$55/mo</span>
        </p>
      </div>

      <!-- Membership cards -->
      <div class="grid sm:grid-cols-2 gap-8">
        {memberships.map((membership, i) => (
          <div class:list={["animate-scale-in", `stagger-${i + 1}`]}>
            <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 border border-gold-light/30">
              <!-- Gold accent top border -->
              <div class="h-1.5 bg-gradient-to-r from-gold-light via-gold-light/60 to-gold-light"></div>

              <div class="p-8 text-center">
                <h3 class="font-heading text-xl text-warm-gray-900 mb-4">
                  {membership.name}
                </h3>
                <p class="text-4xl font-bold text-warm-gray-900 mb-1">
                  {membership.price}
                </p>
                <p class="text-warm-gray-500 text-sm mb-6">
                  {membership.priceNote}
                </p>
                <p class="text-warm-gray-700 leading-relaxed mb-8">
                  {membershipDescriptions[membership.name]}
                </p>
                <a
                  href={business.bookingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block bg-blush-500 text-white px-8 py-3 rounded-full font-semibold hover:bg-blush-600 transition min-h-[44px]"
                >
                  Book Now
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Fine print -->
      <p class="text-center text-warm-gray-500 text-sm mt-8">
        Memberships are available at your appointment. Ask your esthetician for details.
      </p>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- 5. Testimonials — Featured pull-quote + supporting quotes          -->
  <!-- ================================================================== -->
  <section class="py-12 md:py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Section header -->
      <div class="text-center mb-12 md:mb-16 animate-fade-up">
        <h2 class="font-heading text-3xl sm:text-4xl text-warm-gray-900 mb-4">
          What Our Clients Say
        </h2>
      </div>

      <!-- Featured testimonial — large pull-quote -->
      <div class="mb-12 md:mb-16 animate-fade-up">
        <div class="max-w-3xl mx-auto text-center relative px-4">
          <!-- Decorative oversized quotation mark -->
          <span
            class="absolute -top-6 left-1/2 -translate-x-1/2 text-blush-100 font-heading text-[8rem] md:text-[12rem] leading-none pointer-events-none select-none"
            aria-hidden="true"
          >&ldquo;</span>
          <blockquote class="relative z-10">
            <p class="font-heading text-xl sm:text-2xl md:text-3xl text-warm-gray-900 leading-relaxed mb-6">
              &ldquo;{featuredTestimonial.quote}&rdquo;
            </p>
            <footer class="flex items-center justify-center gap-3 text-base">
              <div class="w-10 h-10 rounded-full bg-blush-100 flex items-center justify-center">
                <span class="text-sm font-semibold text-blush-600">{featuredTestimonial.initials}</span>
              </div>
              <div class="text-left">
                <p class="font-semibold text-warm-gray-900 text-sm">{featuredTestimonial.name}</p>
                <p class="text-warm-gray-500 text-xs">{featuredTestimonial.source}</p>
              </div>
            </footer>
          </blockquote>
        </div>
      </div>

      <!-- Supporting testimonials -->
      <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {supportingTestimonials.map((t, i) => (
          <div class:list={["animate-fade-up", `stagger-${i + 1}`]}>
            <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-blush-100/50">
              <div class="flex gap-0.5 mb-4" aria-label="5 out of 5 stars">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="w-4 h-4 text-gold-light" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <div class="relative">
                <span class="absolute -top-4 -left-1 text-4xl text-blush-200 font-heading leading-none pointer-events-none select-none" aria-hidden="true">&ldquo;</span>
                <blockquote class="text-warm-gray-800 italic text-lg leading-relaxed pl-4 mb-5">
                  {t.quote}
                </blockquote>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-blush-100 flex items-center justify-center shrink-0">
                  <span class="text-sm font-semibold text-blush-600">{t.initials}</span>
                </div>
                <div>
                  <p class="font-semibold text-warm-gray-900 text-sm">{t.name}</p>
                  <p class="text-warm-gray-500 text-xs">{t.source}</p>
                </div>
                {t.service && (
                  <span class="ml-auto bg-blush-50 text-blush-600 text-xs font-medium px-2.5 py-1 rounded-full">
                    {t.service}
                  </span>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Google reviews link -->
      <div class="text-center mt-10 animate-fade-up">
        <a
          href={business.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-blush-500 font-semibold hover:text-blush-600 transition"
        >
          Read all reviews on Google &rarr;
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-20 h-0.5 bg-blush-300/40 mx-auto my-8" aria-hidden="true"></div>

  <!-- ================================================================== -->
  <!-- 6. The Cottage / About Teaser — Emotional editorial moment         -->
  <!-- ================================================================== -->
  <section class="relative py-12 md:py-16 overflow-hidden">
    <!-- Subtle linen background -->
    <div class="absolute inset-0 bg-linen pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-center">
        <!-- Cottage photo with organic shape -->
        <div class="md:col-span-7 animate-fade-up">
          <div class="relative">
            <img
              src="/images/cottage/exterior.jpg"
              alt="Bashful Beauty's charming cottage studio in downtown Rockwall"
              class="w-full aspect-[4/3] object-cover rounded-3xl shadow-lg"
              loading="lazy"
            />
            <!-- Decorative shadow behind image -->
            <div
              class="absolute -z-10 -bottom-3 -right-3 w-full h-full rounded-3xl bg-blush-100/50"
              aria-hidden="true"
            ></div>
          </div>
        </div>

        <!-- Story text -->
        <div class="md:col-span-5 animate-fade-up stagger-1">
          <p class="text-blush-500 font-semibold text-sm uppercase tracking-widest mb-3">Our Story</p>
          <h2 class="font-heading text-3xl md:text-4xl text-warm-gray-900 mb-6">
            Doe's Skincare Cottage
          </h2>
          <p class="text-warm-gray-700 text-base md:text-lg leading-relaxed mb-4">
            With over 20 years in the beauty industry, Doe Hernandez built Bashful Beauty in the heart of downtown Rockwall.
          </p>
          <p class="text-warm-gray-700 text-base md:text-lg leading-relaxed mb-8">
            Our little cottage behind Bin 303 is where world-class skincare meets small-town charm. The moment you walk in, it feels like home.
          </p>
          <a
            href="/about"
            class="inline-block text-blush-500 font-semibold text-lg hover:text-blush-600 transition"
          >
            Meet Doe & the Team &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- 7. "New Here?" — First-time visitor reassurance                    -->
  <!-- ================================================================== -->
  <section class="py-12 md:py-16 px-6 bg-cream">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12 animate-fade-up">
        <h2 class="font-heading text-3xl sm:text-4xl text-warm-gray-900 mb-3">
          Your First Visit
        </h2>
        <p class="text-warm-gray-700 text-lg">New here? We make it easy.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6">
        <!-- Step 1 -->
        <div class="text-center animate-fade-up stagger-1">
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-blush-50 flex items-center justify-center">
            <span class="font-heading text-2xl text-blush-500">1</span>
          </div>
          <h3 class="font-semibold text-warm-gray-900 text-lg mb-2">Book Online or Call</h3>
          <p class="text-warm-gray-600 text-sm leading-relaxed">
            Pick your service and time. It takes about 30 seconds.
          </p>
        </div>
        <!-- Step 2 -->
        <div class="text-center animate-fade-up stagger-2">
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-blush-50 flex items-center justify-center">
            <span class="font-heading text-2xl text-blush-500">2</span>
          </div>
          <h3 class="font-semibold text-warm-gray-900 text-lg mb-2">Arrive at the Cottage</h3>
          <p class="text-warm-gray-600 text-sm leading-relaxed">
            Find us behind Bin 303 on Goliad St. Parking is free.
          </p>
        </div>
        <!-- Step 3 -->
        <div class="text-center animate-fade-up stagger-3">
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-blush-50 flex items-center justify-center">
            <span class="font-heading text-2xl text-blush-500">3</span>
          </div>
          <h3 class="font-semibold text-warm-gray-900 text-lg mb-2">Leave Feeling Amazing</h3>
          <p class="text-warm-gray-600 text-sm leading-relaxed">
            Relax, let us do our thing, and walk out glowing.
          </p>
        </div>
      </div>

      <div class="text-center mt-10 animate-fade-up">
        <a
          href="/faq"
          class="text-blush-500 font-semibold hover:text-blush-600 transition"
        >
          Have questions? Check our FAQ &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- 8. Booking CTA                                                     -->
  <!-- ================================================================== -->
  <BookingCTA />
</BaseLayout>
