---
/**
 * About — Editorial storytelling: Doe's story, the cottage, the team, and social proof.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { business } from '../data/business';
import { team } from '../data/team';
import { testimonials } from '../data/testimonials';

/** Pull a featured quote for the pull-quote section */
const featuredQuote = testimonials.find((t) => t.verified) ?? testimonials[0];

/** Doe is always first in the team array */
const doe = team.find((m) => m.name === 'Doe Hernandez');
const otherMembers = team.filter((m) => m.name !== 'Doe Hernandez');

/** Placeholder count — show 3 placeholders if we only have Doe */
const placeholderCount = otherMembers.length === 0 ? 3 : 0;
---

<BaseLayout
  title="About Bashful Beauty | Our Story"
  description="Meet Doe Hernandez and the Bashful Beauty team. Over 20 years of expertise in the heart of downtown Rockwall, TX."
>
  <!-- ================================================================== -->
  <!-- Hero — Full-width team photo with overlay heading                   -->
  <!-- ================================================================== -->
  <section class="relative overflow-hidden">
    <div class="relative h-[50vh] md:h-[60vh] lg:h-[65vh]">
      <img
        src="/images/hero/team-group.jpg"
        alt="The Bashful Beauty team together at the downtown Rockwall cottage"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-warm-gray-900/70 via-warm-gray-900/20 to-transparent"></div>
      <!-- Heading overlaid -->
      <div class="absolute bottom-0 left-0 right-0 px-6 pb-8 md:pb-12 md:pl-12 text-center md:text-left">
        <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl text-white leading-tight drop-shadow-lg">
          Our Story
        </h1>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Doe's Story — Editorial layout with float + pull quote              -->
  <!-- ================================================================== -->
  <section class="py-12 md:py-16 px-6 animate-fade-up">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl text-warm-gray-900 mb-8 md:mb-10">
        Meet Doe Hernandez
      </h2>

      <!-- Mobile: photo above text -->
      <div class="mb-8 md:hidden">
        <img
          src="/images/team/doe.jpg"
          alt="Doe Hernandez, Owner and Lead Esthetician at Bashful Beauty"
          class="w-full max-w-sm mx-auto rounded-3xl object-cover object-top aspect-[3/4] shadow-lg"
          loading="lazy"
        />
      </div>

      <!-- Desktop: floated photo on right -->
      <div class="hidden md:block float-right ml-10 mb-6 w-[320px] lg:w-[360px]">
        <img
          src="/images/team/doe.jpg"
          alt="Doe Hernandez, Owner and Lead Esthetician at Bashful Beauty"
          class="w-full rounded-3xl object-cover object-top aspect-[3/4] shadow-lg"
          loading="lazy"
        />
        <!-- Featured-in badge -->
        <p class="mt-4 text-center text-warm-gray-500 text-sm tracking-wide uppercase">
          As featured in <strong class="text-warm-gray-700">Voyage Dallas Magazine</strong>
        </p>
      </div>

      <div class="text-warm-gray-700 text-lg leading-relaxed space-y-6">
        <p>
          Twenty years ago, Doe Hernandez fell in love with skin. Not the surface-level kind of love — the deep, nerdy, "let me understand why this ingredient works at the cellular level" kind. That curiosity turned into a career, and that career turned into Bashful Beauty.
        </p>
        <p>
          What sets Doe apart is her scientifically-based approach to beauty. While trends come and go, she builds every treatment on evidence — what actually works, why it works, and how to make results last. It's the reason clients trust her with everything from a first-time Brazilian to a custom anti-aging facial.
        </p>
        <p>
          Over two decades, she's built something rare: a studio where you feel like family from the moment you walk in. Where the results speak for themselves, and where no question is too awkward to ask. She assembled a team of talented estheticians who share her standards, and together they've made Bashful Beauty Rockwall's most trusted name in beauty.
        </p>

        <!-- Pull quote -->
        <blockquote class="relative my-10 py-6 px-6 md:px-10 border-l-4 border-blush-300 bg-blush-50/50 rounded-r-xl">
          <span class="absolute -top-4 left-4 text-blush-200 text-6xl font-heading leading-none select-none" aria-hidden="true">&ldquo;</span>
          <p class="font-heading text-xl md:text-2xl text-warm-gray-800 italic leading-relaxed">
            {featuredQuote.quote}
          </p>
          <cite class="block mt-3 text-warm-gray-500 text-sm not-italic">
            &mdash; {featuredQuote.source}
          </cite>
        </blockquote>

        <p>
          The reputation followed naturally. A 4.9-star Google rating from {business.reviews.google.count} reviews. Features in Voyage Dallas Magazine. And a waitlist that keeps growing — because once people experience the cottage, they don't go anywhere else.
        </p>
      </div>

      <!-- Mobile featured-in badge -->
      <p class="mt-6 md:hidden text-warm-gray-500 text-sm tracking-wide uppercase text-center">
        As featured in <strong class="text-warm-gray-700">Voyage Dallas Magazine</strong>
      </p>

      <!-- Clear the float -->
      <div class="clear-both"></div>
    </div>
  </section>

  <div class="max-w-20 h-0.5 bg-blush-300/40 mx-auto my-8" aria-hidden="true"></div>

  <!-- ================================================================== -->
  <!-- The Cottage                                                         -->
  <!-- ================================================================== -->
  <section class="py-12 md:py-16 px-6  animate-fade-up">
    <div class="max-w-5xl mx-auto">
      <!-- Mobile: image first -->
      <div class="mb-8 md:hidden">
        <img
          src="/images/cottage/exterior.jpg"
          alt="Bashful Beauty's charming cottage studio in downtown Rockwall"
          class="w-full rounded-3xl object-cover aspect-[4/3] shadow-lg"
          loading="lazy"
        />
      </div>

      <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
        <!-- Image — desktop only (mobile already shown above) -->
        <div class="hidden md:block">
          <img
            src="/images/cottage/exterior.jpg"
            alt="Bashful Beauty's charming cottage studio in downtown Rockwall"
            class="w-full rounded-3xl object-cover aspect-[4/3] shadow-lg"
            loading="lazy"
          />
        </div>

        <!-- Text -->
        <div>
          <h2 class="font-heading text-3xl sm:text-4xl text-warm-gray-900 mb-6">
            The Cottage
          </h2>
          <div class="text-warm-gray-700 text-lg leading-relaxed space-y-5">
            <p>
              Tucked behind Bin 303 in the heart of downtown Rockwall, Bashful Beauty lives in a place that feels nothing like a typical spa. It's a cottage — warm wood, soft light, and the kind of quiet that makes you exhale the moment you step inside.
            </p>
            <p>
              Every treatment room is designed for comfort and privacy. Whether you're here for a quick brow shape or a full custom facial, the cottage is your escape from the everyday. Clients often say it feels like walking into a friend's house — and that's exactly the point.
            </p>
          </div>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 mt-6 text-blush-500 font-semibold text-lg hover:text-blush-600 transition"
          >
            Get Directions
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Meet the Team                                                       -->
  <!-- ================================================================== -->
  <section class="py-12 md:py-16 px-6 animate-fade-up">
    <div class="max-w-5xl mx-auto">
      <!-- Section header -->
      <div class="text-center mb-8 md:mb-12">
        <h2 class="font-heading text-3xl sm:text-4xl text-warm-gray-900 mb-4">
          The Team
        </h2>
        <p class="text-warm-gray-700 text-lg max-w-2xl mx-auto leading-relaxed">
          The talented group of estheticians behind Bashful Beauty.
        </p>
      </div>

      <!-- Team grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
        <!-- Doe — feature card spanning 2 columns -->
        {doe && (
          <div class="col-span-2 bg-linen rounded-2xl p-6 md:p-8 flex flex-col sm:flex-row gap-6 items-center sm:items-start shadow-sm">
            <img
              src={doe.image}
              alt={doe.name}
              class="w-28 h-28 sm:w-36 sm:h-36 rounded-full object-cover shadow-md shrink-0"
              loading="lazy"
            />
            <div class="text-center sm:text-left">
              <h3 class="font-heading text-xl md:text-2xl text-warm-gray-900 mb-1">{doe.name}</h3>
              <p class="text-blush-500 text-sm font-semibold mb-3">{doe.role}</p>
              <p class="text-warm-gray-700 leading-relaxed">{doe.bio}</p>
            </div>
          </div>
        )}

        <!-- Other team members -->
        {otherMembers.map((member) => (
          <div class="text-center">
            {member.image ? (
              <img
                src={member.image}
                alt={member.name}
                class="w-24 h-24 md:w-28 md:h-28 mx-auto rounded-full object-cover shadow-md mb-4"
                loading="lazy"
              />
            ) : (
              <div class="w-24 h-24 md:w-28 md:h-28 mx-auto rounded-full bg-blush-50 flex items-center justify-center mb-4 shadow-md">
                <span class="text-blush-300 text-2xl md:text-3xl font-heading">{member.name.charAt(0)}</span>
              </div>
            )}
            <h3 class="font-heading text-base md:text-lg text-warm-gray-900 mb-1">{member.name}</h3>
            <p class="text-blush-500 text-xs md:text-sm font-medium">{member.role}</p>
          </div>
        ))}

        <!-- Placeholder cards for upcoming team members -->
        {Array.from({ length: placeholderCount }).map(() => (
          <div class="text-center">
            <div class="w-24 h-24 md:w-28 md:h-28 mx-auto rounded-full bg-blush-100 flex items-center justify-center mb-4 shadow-sm">
              <!-- Person silhouette -->
              <svg class="w-10 h-10 md:w-12 md:h-12 text-blush-300" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v1.2c0 .7.5 1.2 1.2 1.2h16.8c.7 0 1.2-.5 1.2-1.2v-1.2c0-3.2-6.4-4.8-9.6-4.8z" />
              </svg>
            </div>
            <h3 class="font-heading text-base text-warm-gray-500 mb-1">Team Member</h3>
            <p class="text-blush-400 text-xs md:text-sm font-medium">Esthetician</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-20 h-0.5 bg-blush-300/40 mx-auto my-8" aria-hidden="true"></div>

  <!-- ================================================================== -->
  <!-- Social Proof Bar                                                    -->
  <!-- ================================================================== -->
  <section class="py-10 md:py-12 px-6  animate-fade-up">
    <div class="max-w-4xl mx-auto">
      <!-- Review stats — horizontal on desktop, stacked on mobile -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8 text-center">
        <div class="flex items-center gap-2">
          <span class="text-gold-light text-xl">&#9733;</span>
          <span class="text-warm-gray-900 font-semibold text-lg">{business.reviews.google.rating}</span>
          <span class="text-warm-gray-600 text-sm">Google ({business.reviews.google.count})</span>
        </div>
        <span class="hidden sm:inline text-warm-gray-300" aria-hidden="true">&middot;</span>
        <div class="flex items-center gap-2">
          <span class="text-gold-light text-xl">&#9733;</span>
          <span class="text-warm-gray-900 font-semibold text-lg">{business.reviews.facebook.rating}</span>
          <span class="text-warm-gray-600 text-sm">Facebook ({business.reviews.facebook.count})</span>
        </div>
        <span class="hidden sm:inline text-warm-gray-300" aria-hidden="true">&middot;</span>
        <div class="flex items-center gap-2">
          <span class="text-gold-light text-xl">&#9733;</span>
          <span class="text-warm-gray-900 font-semibold text-lg">{business.reviews.yelp.rating}</span>
          <span class="text-warm-gray-600 text-sm">Yelp ({business.reviews.yelp.count})</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Booking CTA                                                         -->
  <!-- ================================================================== -->
  <BookingCTA />
</BaseLayout>
