---
/**
 * WatercolorDivider — Decorative section divider with a soft watercolor gradient.
 */
---

<div class="my-12 flex justify-center" aria-hidden="true">
  <div
    class="h-1 w-full max-w-xs rounded-full opacity-40"
    style="background: linear-gradient(90deg, transparent, var(--color-blush-100) 30%, var(--color-blush-200) 50%, var(--color-blush-100) 70%, transparent);"
  >
  </div>
</div>
