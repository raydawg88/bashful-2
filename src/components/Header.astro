---
/**
 * Header — Fixed navigation with phone number, warm cream background.
 * Mobile: logo centered, hamburger left, Book Now right.
 * Desktop: logo left, nav center, phone + Book Now right.
 */
import { business } from '../data/business';

const navLinks = [
  { label: 'Waxing', href: '/waxing' },
  { label: 'Facials', href: '/facials' },
  { label: 'Beauty Services', href: '/beauty-services' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="fixed top-0 w-full z-50 bg-cream/95 backdrop-blur-md border-b border-blush-100/50">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 h-16">
    <!-- Mobile: hamburger left -->
    <button
      id="mobile-menu-open"
      class="md:hidden flex items-center justify-center w-11 h-11"
      aria-label="Open menu"
    >
      <span class="flex flex-col justify-center gap-1.5">
        <span class="block w-5 h-0.5 bg-warm-gray-900 rounded-full"></span>
        <span class="block w-5 h-0.5 bg-warm-gray-900 rounded-full"></span>
        <span class="block w-5 h-0.5 bg-warm-gray-900 rounded-full"></span>
      </span>
    </button>

    <!-- Logo -->
    <a
      href="/"
      class="font-heading text-[1.4rem] md:text-[1.6rem] font-semibold italic text-warm-gray-900 hover:text-warm-gray-900 tracking-tight"
    >
      Bashful Beauty
    </a>

    <!-- Desktop nav (center) -->
    <nav class="hidden md:flex items-center gap-7" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-body text-sm text-warm-gray-700 hover:text-blush-500 transition"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop: phone + Book Now -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href={business.phoneHref}
        class="flex items-center gap-1.5 text-sm text-warm-gray-700 hover:text-blush-500 transition"
      >
        <!-- Phone icon -->
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        {business.phone}
      </a>
      <a
        href={business.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-blush-500 text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-blush-600 transition"
      >
        Book Now
      </a>
    </div>

    <!-- Mobile: small Book Now button right -->
    <a
      href={business.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="md:hidden bg-blush-500 text-white px-4 py-1.5 rounded-full text-xs font-semibold hover:bg-blush-600 transition"
    >
      Book Now
    </a>
  </div>
</header>

<!-- Mobile menu overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 bg-cream z-50 flex-col hidden"
  aria-label="Mobile navigation"
>
  <!-- Top bar: close button -->
  <div class="flex items-center justify-between px-4 h-16">
    <div class="w-11"></div>
    <a href="/" class="font-heading text-[1.4rem] font-semibold italic text-warm-gray-900">
      Bashful Beauty
    </a>
    <button
      id="mobile-menu-close"
      class="w-11 h-11 flex items-center justify-center"
      aria-label="Close menu"
    >
      <svg class="w-6 h-6 text-warm-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Nav links — vertically centered -->
  <nav class="flex-1 flex flex-col items-center justify-center gap-8">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="text-2xl font-heading text-warm-gray-900 hover:text-blush-500 transition mobile-nav-link"
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Bottom: Book Now + social -->
  <div class="flex flex-col items-center gap-6 pb-12 px-6">
    <a
      href={business.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full max-w-xs bg-blush-500 text-white py-3.5 rounded-full text-center text-lg font-semibold hover:bg-blush-600 transition"
    >
      Book Now
    </a>
    <a
      href={business.phoneHref}
      class="flex items-center gap-2 text-warm-gray-700 hover:text-blush-500 transition text-sm"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
      </svg>
      {business.phone}
    </a>
    <!-- Social icons -->
    <div class="flex gap-5">
      <a href={business.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-warm-gray-500 hover:text-blush-500 transition">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
        </svg>
      </a>
      <a href={business.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-warm-gray-500 hover:text-blush-500 transition">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
        </svg>
      </a>
      <a href={business.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="text-warm-gray-500 hover:text-blush-500 transition">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
        </svg>
      </a>
    </div>
  </div>
</div>

<!-- Spacer for fixed header -->
<div class="h-16"></div>

<script>
  const openBtn = document.getElementById('mobile-menu-open');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');

  function openMenu() {
    menu?.classList.remove('hidden');
    menu?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.add('hidden');
    menu?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Close menu when a nav link is clicked
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
