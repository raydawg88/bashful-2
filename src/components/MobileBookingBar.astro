---
/**
 * MobileBookingBar — Sticky bottom bar with Call + Book Now buttons.
 * Visible only on mobile. Sized for comfortable thumb targets (48px+).
 */
import { business } from '../data/business';
---

<div class="fixed bottom-0 left-0 right-0 z-40 md:hidden bg-cream/95 backdrop-blur-md border-t border-blush-100/50 shadow-[0_-4px_12px_rgba(0,0,0,0.05)] px-4 py-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
  <div class="flex gap-3">
    <!-- Call button — outlined -->
    <a
      href={business.phoneHref}
      class="flex items-center justify-center gap-2 w-[40%] py-3 rounded-full border-2 border-blush-500 text-blush-500 font-semibold text-sm hover:bg-blush-50 transition"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
      </svg>
      Call
    </a>
    <!-- Book Now button — solid -->
    <a
      href={business.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center w-[60%] py-3 rounded-full bg-blush-500 text-white font-semibold text-sm hover:bg-blush-600 transition"
    >
      Book Now
    </a>
  </div>
</div>
