---
/**
 * TestimonialCard — Clean card with avatar circle, 5-star rating,
 * decorative quote mark, and optional service pill badge.
 */
interface Props {
  quote: string;
  name: string;
  source: string;
  initials: string;
  service?: string;
}

const { quote, name, source, initials, service } = Astro.props;
---

<div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-blush-100/50 relative">
  <!-- 5 gold stars -->
  <div class="flex gap-0.5 mb-4" aria-label="5 out of 5 stars">
    {Array.from({ length: 5 }).map(() => (
      <svg class="w-4 h-4 text-gold-light" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>

  <!-- Quote with decorative opening mark -->
  <div class="relative">
    <span
      class="absolute -top-4 -left-1 text-4xl text-blush-200 font-heading leading-none pointer-events-none select-none"
      aria-hidden="true"
    >&ldquo;</span>
    <blockquote class="text-lg md:text-xl text-warm-gray-800 italic leading-relaxed pl-4 mb-5">
      {quote}
    </blockquote>
  </div>

  <!-- Attribution: avatar circle + name + source -->
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-blush-100 flex items-center justify-center shrink-0">
      <span class="text-sm font-semibold text-blush-600">{initials}</span>
    </div>
    <div>
      <p class="font-semibold text-warm-gray-900 text-sm">{name}</p>
      <p class="text-warm-gray-500 text-xs">{source}</p>
    </div>
    {service && (
      <span class="ml-auto bg-blush-50 text-blush-600 text-xs font-medium px-2.5 py-1 rounded-full">
        {service}
      </span>
    )}
  </div>
</div>
