---
interface Props {
  variant?: 'blush' | 'sage' | 'gold';
}
const { variant = 'blush' } = Astro.props;
---

<div class="ambient-wrap" aria-hidden="true">
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  <div class="orb orb-4"></div>
  <div class="orb orb-5"></div>
  <div class="orb orb-6"></div>
  <div class="orb orb-7"></div>
</div>

<style is:global>
  .ambient-wrap {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    will-change: transform;
  }

  /* Pink orbs */
  .orb-1 {
    width: 800px;
    height: 800px;
    top: -15%;
    left: -10%;
    background: rgba(255, 180, 200, 0.2);
    animation: drift1 38s ease-in-out infinite;
  }
  .orb-2 {
    width: 700px;
    height: 700px;
    top: 30%;
    right: -15%;
    background: rgba(248, 164, 178, 0.18);
    animation: drift2 44s ease-in-out infinite;
  }

  /* Yellow/gold orbs — blend with pink to create warm orange where they overlap */
  .orb-3 {
    width: 750px;
    height: 750px;
    bottom: -10%;
    left: 5%;
    background: rgba(255, 220, 120, 0.08);
    animation: drift3 42s ease-in-out infinite;
  }
  .orb-4 {
    width: 650px;
    height: 650px;
    top: 10%;
    left: 40%;
    background: rgba(245, 210, 130, 0.07);
    animation: drift4 36s ease-in-out infinite;
  }

  /* Warm rose */
  .orb-5 {
    width: 700px;
    height: 700px;
    top: 50%;
    right: 10%;
    background: rgba(183, 110, 121, 0.12);
    animation: drift5 48s ease-in-out infinite;
  }

  /* Soft cream/peach */
  .orb-6 {
    width: 800px;
    height: 800px;
    top: -5%;
    right: 20%;
    background: rgba(255, 225, 220, 0.15);
    animation: drift6 40s ease-in-out infinite;
  }

  /* Light blush — fills gaps */
  .orb-7 {
    width: 650px;
    height: 650px;
    bottom: 20%;
    right: -5%;
    background: rgba(255, 204, 212, 0.16);
    animation: drift7 46s ease-in-out infinite;
  }

  @keyframes drift1 {
    0%   { transform: translate(0vw, 0vh); }
    25%  { transform: translate(60vw, 35vh); }
    50%  { transform: translate(30vw, 75vh); }
    75%  { transform: translate(-10vw, 40vh); }
    100% { transform: translate(0vw, 0vh); }
  }
  @keyframes drift2 {
    0%   { transform: translate(0vw, 0vh); }
    25%  { transform: translate(-55vw, 45vh); }
    50%  { transform: translate(-20vw, -25vh); }
    75%  { transform: translate(45vw, 55vh); }
    100% { transform: translate(0vw, 0vh); }
  }
  @keyframes drift3 {
    0%   { transform: translate(0vw, 0vh); }
    25%  { transform: translate(55vw, -55vh); }
    50%  { transform: translate(75vw, 15vh); }
    75%  { transform: translate(15vw, -35vh); }
    100% { transform: translate(0vw, 0vh); }
  }
  @keyframes drift4 {
    0%   { transform: translate(0vw, 0vh); }
    25%  { transform: translate(-45vw, -40vh); }
    50%  { transform: translate(35vw, -15vh); }
    75%  { transform: translate(55vw, 50vh); }
    100% { transform: translate(0vw, 0vh); }
  }
  @keyframes drift5 {
    0%   { transform: translate(0vw, 0vh); }
    25%  { transform: translate(-50vw, -30vh); }
    50%  { transform: translate(-30vw, 40vh); }
    75%  { transform: translate(40vw, -20vh); }
    100% { transform: translate(0vw, 0vh); }
  }
  @keyframes drift6 {
    0%   { transform: translate(0vw, 0vh); }
    25%  { transform: translate(40vw, 50vh); }
    50%  { transform: translate(-30vw, 30vh); }
    75%  { transform: translate(-50vw, -20vh); }
    100% { transform: translate(0vw, 0vh); }
  }
  @keyframes drift7 {
    0%   { transform: translate(0vw, 0vh); }
    25%  { transform: translate(-40vw, -50vh); }
    50%  { transform: translate(50vw, -30vh); }
    75%  { transform: translate(20vw, 40vh); }
    100% { transform: translate(0vw, 0vh); }
  }
</style>
