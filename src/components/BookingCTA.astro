---
/**
 * BookingCTA — Reusable call-to-action section for booking.
 * Used on every page to encourage appointment scheduling.
 */
import { business } from '../data/business';

interface Props {
  heading?: string;
  subtext?: string;
}

const {
  heading = 'Ready to Feel Amazing?',
  subtext = 'Book your appointment today and let us take care of the rest.',
} = Astro.props;
---

<section class="py-16 px-6">
  <div class="max-w-2xl mx-auto text-center bg-gradient-to-br from-cream via-blush-50 to-linen rounded-3xl px-8 py-14 sm:px-12">
    <h2 class="font-heading text-3xl sm:text-4xl text-warm-gray-900 mb-4">
      {heading}
    </h2>
    <p class="text-warm-gray-700 text-lg mb-8 leading-relaxed">
      {subtext}
    </p>
    <a
      href={business.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block bg-blush-500 text-white px-10 py-3.5 rounded-full text-lg font-semibold hover:bg-blush-600 transition"
    >
      Book Now
    </a>
    <p class="mt-6 text-warm-gray-500 text-sm">
      Or call us: <a href={business.phoneHref} class="underline hover:text-blush-500 transition">{business.phone}</a>
    </p>
  </div>
</section>
