---
/**
 * BookingCTA — Reusable call-to-action section for booking.
 * Uses watercolor overlay texture and social proof for personality.
 */
import { business } from '../data/business';

interface Props {
  heading?: string;
  subtext?: string;
}

const {
  heading = 'Ready to Feel Amazing?',
  subtext = 'Book your appointment today and let us take care of the rest.',
} = Astro.props;

const googleReviews = business.reviews.google;
---

<section class="py-14 sm:py-16 px-6">
  <div class="max-w-2xl mx-auto text-center bg-gradient-to-br from-cream via-blush-50 to-linen rounded-3xl px-6 py-12 sm:px-12 sm:py-14 watercolor-overlay relative overflow-hidden">
    <h2 class="font-heading text-3xl sm:text-4xl lg:text-[2.75rem] text-warm-gray-900 mb-4 leading-tight">
      {heading}
    </h2>
    <p class="text-warm-gray-700 text-lg sm:text-xl mb-8 leading-relaxed max-w-md mx-auto">
      {subtext}
    </p>
    <a
      href={business.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block w-full sm:w-auto bg-blush-500 text-white px-10 py-3.5 rounded-full text-lg font-semibold hover:bg-blush-600 transition"
    >
      Book Now
    </a>
    <!-- Social proof -->
    <p class="mt-5 flex items-center justify-center gap-1.5 text-warm-gray-500 text-sm">
      <span class="text-gold-light">&#9733;</span>
      <span>{googleReviews.rating} from {googleReviews.count} reviews</span>
    </p>
    <p class="mt-4 text-warm-gray-500 text-sm">
      Or call us: <a href={business.phoneHref} class="underline hover:text-blush-500 transition">{business.phone}</a>
    </p>
  </div>
</section>
