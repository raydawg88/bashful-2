---
/**
 * ServiceCard — Editorial-style card for a service category.
 * Mobile: horizontal layout (image left, text right).
 * Desktop: vertical portrait card with image zoom on hover.
 */
interface Props {
  title: string;
  description: string;
  href: string;
  imageSrc?: string;
}

const { title, description, href, imageSrc } = Astro.props;
---

<a
  href={href}
  class="group block bg-white rounded-2xl overflow-hidden border border-blush-100 hover:bg-blush-50/50 transition-colors duration-300"
>
  <!-- Mobile: horizontal / sm+: vertical -->
  <div class="flex flex-row sm:flex-col">
    <!-- Image area -->
    {imageSrc ? (
      <div class="w-32 h-32 sm:w-full sm:h-auto sm:aspect-[3/4] overflow-hidden shrink-0">
        <img
          src={imageSrc}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="w-32 h-32 sm:w-full sm:h-auto sm:aspect-[3/4] bg-blush-50 flex items-center justify-center shrink-0">
        <span class="text-blush-200 text-4xl sm:text-5xl font-heading">&#10047;</span>
      </div>
    )}

    <!-- Content -->
    <div class="flex flex-col justify-center p-4 sm:p-6 sm:border-t-2 sm:border-blush-300">
      <h3 class="font-heading text-xl sm:text-2xl text-warm-gray-900 mb-1 sm:mb-2">{title}</h3>
      <p class="text-warm-gray-700 text-sm leading-relaxed line-clamp-3 sm:line-clamp-none">{description}</p>
    </div>
  </div>
</a>
